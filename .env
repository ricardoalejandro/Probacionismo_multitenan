# ============================================================
# 🔐 VARIABLES DE ENTORNO - PRODUCCIÓN
# ============================================================
# IMPORTANTE: Este archivo contiene secretos sensibles
# NO subir a repositorios públicos
# Usar: docker compose --env-file .env.production up -d
# ============================================================

# ============================================================
# 🌍 ENTORNO Y DOMINIO
# ============================================================
NODE_ENV=production

# Dominio principal (sin https://, sin www)
DOMAIN=naperu.cloud

# Nombre de la aplicación (usado para identificar rutas en Traefik)
APP_NAME=naperu

# ============================================================
# 🗄️ BASE DE DATOS - PostgreSQL
# ============================================================
# Credenciales de la base de datos (interno Docker)
POSTGRES_USER=probacionismo_admin
POSTGRES_PASSWORD=Pr0b@c10n1sm0_DB_2026!Secure
POSTGRES_DB=probacionismo_prod

# URL de conexión (generada automáticamente por docker-compose)
# DATABASE_URL se construye en docker-compose.yml

# ============================================================
# 📦 REDIS - Caché y Sesiones
# ============================================================
REDIS_PASSWORD=R3d1s_C@che_2026!Pr0d

# ============================================================
# 🔑 SEGURIDAD - JWT
# ============================================================
# Token de 64 caracteres para firmar JWT (generado con: openssl rand -base64 48)
JWT_SECRET=3ycOsk7OzpwXockP+JWoqcX0tI5Hkm0/Fbu2cwCFrJwSLubnpqlHilLoVsTh2d5w

# Expiración del token (opcional, por defecto 24h)
# JWT_EXPIRES_IN=24h

# ============================================================
# 🖥️ BACKEND - Fastify API
# ============================================================
# Puerto interno del contenedor (no expuesto al público)
BACKEND_PORT=3000

# Orígenes permitidos para CORS
CORS_ORIGIN=https://${DOMAIN}

# ============================================================
# 🎨 FRONTEND - Next.js
# ============================================================
# Puerto interno del contenedor
FRONTEND_PORT=5000

# URL de la API (como la ve el navegador del usuario)
NEXT_PUBLIC_API_URL=https://${DOMAIN}/api

# ============================================================
# 🌐 PUERTOS EXTERNOS (Host del VPS)
# ============================================================
# Con Nginx como reverse proxy, estos puertos NO se exponen al público
# Solo se usan para comunicación interna Docker <-> Nginx
BACKEND_EXTERNAL_PORT=3001
FRONTEND_EXTERNAL_PORT=5001

# Base de datos y Redis: NO exponer nunca en producción
# POSTGRES_EXTERNAL_PORT=5432  # ❌ Comentado por seguridad
# REDIS_EXTERNAL_PORT=6379     # ❌ Comentado por seguridad

# ============================================================
# 👤 ADMIN INICIAL (solo para primer seed)
# ============================================================
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CambiarInmediatamente2026!
ADMIN_INITIAL_EMAIL=admin@${DOMAIN}

# ============================================================
# 📧 SMTP - Correo Electrónico (Opcional)
# ============================================================
# Configurar para recuperación de contraseña y notificaciones
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=notificaciones@naperu.cloud
# SMTP_PASSWORD=tu_app_password_aqui
# SMTP_FROM_NAME=Sistema Académico
# SMTP_FROM_EMAIL=notificaciones@naperu.cloud

# ============================================================
# 🔐 GOOGLE OAUTH (Opcional)
# ============================================================
# Para login con Google, configurar en Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://${DOMAIN}/api/auth/google/callback

# ============================================================
# 📊 MONITOREO Y LOGS (Opcional)
# ============================================================
# LOG_LEVEL=info
# ENABLE_REQUEST_LOGGING=true

# ============================================================
# 🚀 DESPLIEGUE
# ============================================================
# Comando para desplegar:
# docker compose --env-file .env.production up -d --build
#
# Verificar servicios:
# docker compose ps
#
# Ver logs:
# docker compose logs -f backend
# docker compose logs -f frontend
