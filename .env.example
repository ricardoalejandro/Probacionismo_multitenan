# ==================================
# VARIABLES DE ENTORNO - PLANTILLA
# ==================================
# Copia este archivo a .env y modifica los valores según tu entorno
# cp .env.example .env

# ==================================
# SEGURIDAD
# ==================================
# JWT Secret - OBLIGATORIO (mínimo 32 caracteres)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-2024

# Contraseña inicial del admin (solo se usa al ejecutar seed)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CambiarDespuesDelPrimerLogin123
ADMIN_INITIAL_EMAIL=admin@ejemplo.com

# ==================================
# BASE DE DATOS (Supabase / PostgreSQL)
# ==================================
# Conexión directa a tu base de datos
# El parámetro ?schema=nombre permite aislar proyectos en la misma DB
DATABASE_URL="postgresql://postgres:TU_PASSWORD@TU_HOST:5432/postgres?schema=tu_esquema"

# Variables legacy (para compatibilidad con docker-compose local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multitenant_db

# ==================================
# SUPABASE PUBLIC CONFIG (Frontend)
# ==================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ==================================
# REDIS
# ==================================
REDIS_PORT=6379
REDIS_PASSWORD=tu_redis_password

# ==================================
# BACKEND API
# ==================================
NODE_ENV=production
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5000

# ==================================
# FRONTEND
# ==================================
FRONTEND_PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ==================================
# PUERTOS EXTERNOS (HOST)
# ==================================
POSTGRES_EXTERNAL_PORT=5432
REDIS_EXTERNAL_PORT=6379
BACKEND_EXTERNAL_PORT=3000
FRONTEND_EXTERNAL_PORT=5000

# ==================================
# GOOGLE OAUTH (OPCIONAL)
# ==================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ==================================
# SMTP (OPCIONAL)
# ==================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_email@gmail.com
# SMTP_PASSWORD=tu_password_de_aplicacion
# SMTP_FROM_NAME=Sistema Académico
